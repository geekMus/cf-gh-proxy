# 本地开发用（wrangler dev 会自动读取，不要提交真实值）
# 复制成 .dev.vars 后按需修改

PREFIX=/
JSDELIVR=0
CACHE_TTL=300
IMMUTABLE_CACHE_TTL=86400
UPSTREAM_TIMEOUT=30000
MAX_REDIRECTS=5
ALLOW_AUTH=0
BLOCKED_UA=netcraft
LANDING_LINK=https://github.com/geekMus/cf-gh-proxy

# 主页伪装（与上游 cmliu/CF-Workers-GitHub 语义一致，两者都不设则显示说明页）
# URL302=https://t.me/xxx
# URL=nginx
